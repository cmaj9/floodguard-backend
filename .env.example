# ========== Server ==========
PORT=3001

# ========== PostgreSQL ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=water_monitor
DB_USER=postgres
DB_PASSWORD=your_password_here

# ========== ChirpStack Integration ==========
# Option A (Local): ใส่ MQTT_BROKER เพื่อรับข้อมูลผ่าน MQTT
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=application/+/device/+/event/up
# Option B (Cloud/Railway): ปล่อย MQTT_BROKER ว่างไว้ แล้วใช้ ChirpStack HTTP Webhook
# ชี้ ChirpStack HTTP Integration URL ไปที่: POST /api/readings/webhook?event=up
# MQTT_BROKER=

# ========== CORS ==========
FRONTEND_URL=http://localhost:5173

# ========== LINE Messaging API ==========
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_LIFF_ID=your_line_liff_id_here

# ========== Alert Settings ==========
RATE_OF_RISE_THRESHOLD=0.30
BATTERY_LOW_THRESHOLD=20
OFFLINE_TIMEOUT_MINUTES=60
GEOFENCE_RADIUS_METERS=100
ALERT_COOLDOWN_MINUTES=60
