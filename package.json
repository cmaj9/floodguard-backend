{
  "name": "floodguard-backend",
  "version": "1.1.2",
  "description": "Backend for FloodGuard Water Level Telemetry & Early Warning System - ChirpStack MQTT to PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:sync:railway": "node src/scripts/syncToRailway.js",
    "db:sync:from:railway": "node src/scripts/syncFromRailway.js"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "mqtt": "^5.10.4",
    "node-cron": "^4.6.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
